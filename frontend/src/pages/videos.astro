---
import Base from "../layouts/Base.astro";

// Pega aquí el enlace de cada video de YouTube.
// Si un video todavía no está listo, deja la url vacía ("").
const videos = [
  {
    titulo: "Backend con FastAPI para una loteria mazahua",
    descripcion:
      "Funcionamiento de la API REST: endpoints, documentación en Swagger UI.",
    url: "https://youtu.be/DqFujFIm6sM?si=MMh9WqhHh8dEwgA3",
  },
  {
    titulo: "Frontend con Astro para una loteria mazahua",
    descripcion:
      "Recorrido por la interfaz web: página de inicio, catálogo, administración y juego de lotería.",
    url: "https://youtu.be/1mDIooR2ucU?si=SdDjdDipvJ7CwUXi",
  },
  {
    titulo: "Consumo de la API",
    descripcion:
      "Comunicación entre Astro y FastAPI: los datos que se muestran en pantalla provienen de la base de datos.",
    url: "https://youtu.be/1mDIooR2ucU?si=SdDjdDipvJ7CwUXi",
  },
];

// Obtiene el identificador del video a partir de cualquier formato de enlace de YouTube
function idDeYoutube(url: string): string | null {
  if (!url) return null;
  const m = url.match(
    /(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/))([\w-]{11})/
  );
  return m ? m[1] : null;
}

const lista = videos.map((v) => ({ ...v, id: idDeYoutube(v.url) }));
---

<Base titulo="Videos">
  <h2>Videos de demostración</h2>
  <p class="intro">
    Evidencias en video del funcionamiento del sistema: backend, frontend,
    consumo de la API y reproducción de los recursos multimedia.
  </p>

  <div class="videos">
    {lista.map((v) => (
      <article class="video">
        {v.id ? (
          <div class="marco">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.id}`}
              title={v.titulo}
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        ) : (
          <div class="marco pendiente">Video próximamente</div>
        )}
        <h3>{v.titulo}</h3>
        <p>{v.descripcion}</p>
        {v.id && (
          <a href={v.url} target="_blank" rel="noopener noreferrer">
            Ver en YouTube
          </a>
        )}
      </article>
    ))}
  </div>
</Base>

<style>
  .intro { max-width: 760px; line-height: 1.6; margin-bottom: 1.5rem; }
  .videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }
  .video {
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: 6px;
    padding: 1rem;
  }
  .marco {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #f3e6d2;
    border-radius: 4px;
    overflow: hidden;
  }
  .marco iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .pendiente {
    display: grid;
    place-items: center;
    color: #7a6a58;
    font-weight: 600;
  }
  .video h3 { margin: 0.8rem 0 0.3rem; color: var(--acento); font-size: 1.05rem; }
  .video p { margin: 0 0 0.5rem; font-size: 0.92rem; line-height: 1.5; }
  .video a { color: var(--acento); font-weight: 600; }
</style>