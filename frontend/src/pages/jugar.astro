---
import Base from "../layouts/Base.astro";
---

<Base titulo="Jugar">
  <!-- Paso 1: elegir cómo jugar -->
  <div id="modos" class="contenedor-modos">
    <h2 class="titulo-pagina">Jugar a la lotería</h2>

    <section class="modos">
      <button type="button" class="modo-card con-codigo" id="modo-codigo">
        <span class="modo-icono">🔒</span>
        <strong>Jugar con código</strong>
        <span>Tu docente te da un código para entrar a su partida.</span>
      </button>

      <button type="button" class="modo-card libre" id="modo-libre">
        <span class="modo-icono">🎲</span>
        <strong>Jugar sin código</strong>
        <span>Practica por tu cuenta, sin necesidad de un docente.</span>
      </button>
    </section>

    <div class="vitrina-cartas" aria-label="Cartas de ejemplo de la Lotería Mazahua">
      <div id="cartas-preview" class="cartas-abanico"></div>
    </div>
  </div>

  <!-- Paso 2 (solo con código): escribir el código -->
  <section id="entrada" class="entrada" hidden>
    <h3>Escribe el código de tu partida</h3>
    <p>Tu docente te lo da. Tiene 5 letras o números.</p>
    <form id="form-codigo">
      <input
        id="codigo"
        type="text"
        maxlength="8"
        autocomplete="off"
        autocapitalize="characters"
        placeholder="Ej. U3IF1"
        required
      />
      <button class="btn grande" id="btn-entrar" type="submit">Entrar</button>
    </form>
    <p id="aviso-entrada" class="mensaje" role="status"></p>
    <button type="button" id="btn-volver" class="enlace-btn">← Volver</button>
  </section>

  <!-- Paso 3: el juego -->
  <div id="zona-juego" hidden>
    <p class="etiqueta-partida">
      <strong id="etiqueta-partida"></strong> ·
      <button type="button" id="btn-cambiar" class="enlace-btn">Cambiar modo</button>
    </p>

    <details class="guia">
      <summary> ¿Cómo se juega?</summary>
      <ol>
        <li><strong>Toca «Cantar carta»</strong> y se mostrará una carta.</li>
        <li><strong>Escucha</strong> la palabra en mazahua.</li>
        <li><strong>Busca la imagen</strong> en tu tablero y tócala para poner tu ficha.</li>
        <li><strong>¡Lotería!</strong> Gana quien completa una fila, una columna o una diagonal.</li>
      </ol>
    </details>

    <div class="barra">
      <label id="lbl-tamano">Tablero
        <select id="tamano">
          <option value="9">9 cartas (3 × 3)</option>
          <option value="16" selected>16 cartas (4 × 4)</option>
        </select>
      </label>
      <label>Baraja
        <select id="modo">
          <option value="tablero">Solo las cartas de mi tablero</option>
          <option value="todas">Todas las cartas</option>
        </select>
      </label>
      <button type="button" class="btn grande" id="btn-nueva">Nueva partida</button>
      <button type="button" class="btn grande" id="btn-cantar" disabled>Cantar carta</button>
    </div>

    <p id="mensaje" class="mensaje" role="status">Cargando…</p>

    <div class="juego">
      <section class="zona-tablero">
        <h3>Mi tablero</h3>
        <div id="tablero" class="tablero"></div>
      </section>

      <aside class="panel-carta">
        <h3>Carta cantada</h3>
        <div id="actual" class="actual">
          <p class="vacio">Pulsa «Cantar carta» para empezar.</p>
        </div>
        <button type="button" class="btn" id="btn-repetir" disabled>🔊 Repetir audio</button>

        <div class="progreso"><div id="relleno"></div></div>
        <h3 class="contador">Ya salieron <span id="contador"></span></h3>
        <div id="historial" class="historial"></div>
      </aside>
    </div>
  </div>
</Base>

<script>
  import { API, urlArchivo } from "../config";

  interface Elemento {
    id: number;
    nombre_espanol: string;
    nombre_mazahua: string;
    categoria: string | null;
    imagen: string | null;
    audio_mazahua: string | null;
    audio_espanol: string | null;
  }

  interface Partida {
    codigo: string;
    tableros: number;
    cartas_por_tablero: number;
  }

  const CLAVE = "codigo_partida";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const modosEl = $("modos");
  const entradaEl = $("entrada");
  const zonaEl = $("zona-juego");
  const cartasPreviewEl = $("cartas-preview");
  const inputCodigo = $<HTMLInputElement>("codigo");
  const btnEntrar = $<HTMLButtonElement>("btn-entrar");
  const avisoEntradaEl = $("aviso-entrada");
  const etiquetaEl = $("etiqueta-partida");
  const lblTamano = $("lbl-tamano");
  const tamanoSel = $<HTMLSelectElement>("tamano");
  const tableroEl = $("tablero");
  const actualEl = $("actual");
  const historialEl = $("historial");
  const contadorEl = $("contador");
  const rellenoEl = $("relleno");
  const mensajeEl = $("mensaje");
  const modoSel = $<HTMLSelectElement>("modo");
  const btnNueva = $<HTMLButtonElement>("btn-nueva");
  const btnCantar = $<HTMLButtonElement>("btn-cantar");
  const btnRepetir = $<HTMLButtonElement>("btn-repetir");

  let modoJuego: "codigo" | "libre" | null = null;
  let lado = 4;
  let tablero: Elemento[] = [];
  let baraja: Elemento[] = [];
  let cantadas: Elemento[] = [];
  let actual: Elemento | null = null;
  let marcadas = new Set<number>();
  let terminado = false;
  let audio: HTMLAudioElement | null = null;

  function avisar(texto: string, tipo: "ok" | "aviso" | "" = "") {
    mensajeEl.textContent = texto;
    mensajeEl.className = `mensaje ${tipo}`.trim();
  }

  function avisarEntrada(texto: string, tipo: "ok" | "aviso" | "" = "") {
    avisoEntradaEl.textContent = texto;
    avisoEntradaEl.className = `mensaje ${tipo}`.trim();
  }

  function mostrar(pantalla: "modos" | "entrada" | "juego") {
    modosEl.hidden = pantalla !== "modos";
    entradaEl.hidden = pantalla !== "entrada";
    zonaEl.hidden = pantalla !== "juego";
  }

  function barajar<T>(lista: T[]): T[] {
    const a = [...lista];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  const CARTAS_RESPALDO: Elemento[] = [
    { id: -1, nombre_espanol: "Sol", nombre_mazahua: "Jyaru", categoria: null, imagen: null, audio_mazahua: null, audio_espanol: null },
    { id: -2, nombre_espanol: "Libro", nombre_mazahua: "Skuama", categoria: null, imagen: null, audio_mazahua: null, audio_espanol: null },
    { id: -3, nombre_espanol: "Árbol", nombre_mazahua: "Za'a", categoria: null, imagen: null, audio_mazahua: null, audio_espanol: null },
  ];

  function renderCartasPreview(lista: Elemento[]) {
    const seleccion = barajar(lista).slice(0, 3);
    const nodos = seleccion.map((e) => {
      const card = document.createElement("article");
      card.className = "carta-muestra";

      const marco = document.createElement("div");
      marco.className = "carta-muestra-img-wrap";

      const url = urlArchivo(e.imagen);
      if (url) {
        const img = document.createElement("img");
        img.src = url;
        img.alt = e.nombre_espanol;
        img.className = "carta-muestra-img";
        marco.appendChild(img);
      } else {
        const ph = document.createElement("div");
        ph.className = "carta-muestra-sin-img";
        ph.textContent = e.nombre_mazahua.charAt(0).toUpperCase();
        marco.appendChild(ph);
      }

      const titulo = document.createElement("span");
      titulo.className = "carta-muestra-nombre";
      titulo.textContent = e.nombre_mazahua;

      card.append(marco, titulo);
      return card;
    });

    cartasPreviewEl.replaceChildren(...nodos);
  }

  async function cargarCartasPreview() {
    renderCartasPreview(CARTAS_RESPALDO);
    try {
      const r = await fetch(`${API}/api/juego/baraja`);
      if (!r.ok) return;
      const datos = (await r.json()) as Elemento[];
      if (Array.isArray(datos) && datos.length >= 3) {
        renderCartasPreview(datos);
      }
    } catch {}
  }

  function lanzarConfeti() {
    const colores = ["#781c3b", "#e9a825", "#2f7d62", "#1f8a9e", "#f4c542", "#c0476b"];

    const contenedor = document.createElement("div");
    contenedor.className = "confeti";

    for (let i = 0; i < 80; i++) {
      const pieza = document.createElement("span");
      pieza.style.left = Math.random() * 100 + "vw";
      pieza.style.background = colores[Math.floor(Math.random() * colores.length)];
      pieza.style.animationDuration = 2 + Math.random() * 2.5 + "s";
      pieza.style.animationDelay = Math.random() * 0.8 + "s";
      contenedor.appendChild(pieza);
    }

    document.body.appendChild(contenedor);
    setTimeout(() => contenedor.remove(), 6000);
  }

  function detener() {
    audio?.pause();
    audio = null;
  }

  function reproducir(e: Elemento) {
    detener();
    const rutas = [e.audio_mazahua, e.audio_espanol]
      .map(urlArchivo)
      .filter((u): u is string => !!u);
    let i = 0;
    const siguiente = () => {
      if (i >= rutas.length) return;
      audio = new Audio(rutas[i++]);
      audio.addEventListener("ended", siguiente);
      audio.play().catch(() => avisar("No se pudo reproducir el audio.", "aviso"));
    };
    siguiente();
  }

  function imagenODe(e: Elemento, clase: string): HTMLElement {
    const url = urlArchivo(e.imagen);
    if (url) {
      const img = document.createElement("img");
      img.src = url;
      img.alt = e.nombre_espanol;
      img.className = clase;
      return img;
    }
    const ph = document.createElement("div");
    ph.className = `${clase} sin-img`;
    ph.textContent = e.nombre_espanol.charAt(0);
    return ph;
  }

  function pintarTablero() {
    tableroEl.style.gridTemplateColumns = `repeat(${lado}, minmax(0, 1fr))`;
    const casillas = tablero.map((e) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "casilla";
      b.dataset.id = String(e.id);
      if (marcadas.has(e.id)) b.classList.add("marcada");

      const nombre = document.createElement("span");
      nombre.className = "nombre";
      nombre.textContent = e.nombre_mazahua;
      b.append(imagenODe(e, "casilla-img"), nombre);
      b.addEventListener("click", () => marcar(e));
      return b;
    });
    tableroEl.replaceChildren(...casillas);
  }

  function pintarActual() {
    actualEl.classList.remove("nueva");
    if (!actual) {
      actualEl.innerHTML = '<p class="vacio">Pulsa «Cantar carta» para empezar.</p>';
      return;
    }
    const mz = document.createElement("h4");
    mz.textContent = actual.nombre_mazahua;
    const es = document.createElement("p");
    es.textContent = actual.nombre_espanol;
    actualEl.replaceChildren(imagenODe(actual, "actual-img"), mz, es);
    void actualEl.offsetWidth;
    actualEl.classList.add("nueva");
  }

  function pintarHistorial() {
    contadorEl.textContent = `(${cantadas.length}${modoSel.value === "tablero" ? ` de ${tablero.length}` : ""})`;

    const total = modoSel.value === "tablero" ? tablero.length : cantadas.length + baraja.length;
    rellenoEl.style.width = total ? `${(cantadas.length / total) * 100}%` : "0";

    historialEl.replaceChildren(
      ...[...cantadas].reverse().map((e) => {
        const s = document.createElement("span");
        s.className = "chip";
        s.textContent = `${e.nombre_mazahua} · ${e.nombre_espanol}`;
        return s;
      })
    );
  }

  function hayLinea(): boolean {
    const m = (f: number, c: number) => marcadas.has(tablero[f * lado + c].id);
    const rango = [...Array(lado).keys()];
    for (let i = 0; i < lado; i++) {
      if (rango.every((j) => m(i, j))) return true;
      if (rango.every((j) => m(j, i))) return true;
    }
    if (rango.every((i) => m(i, i))) return true;
    if (rango.every((i) => m(i, lado - 1 - i))) return true;
    return false;
  }

  function terminar(texto: string, gano = false) {
    terminado = true;
    btnCantar.disabled = true;
    avisar(texto, "ok");
    if (gano) lanzarConfeti();
  }

  function marcar(e: Elemento) {
    if (terminado || marcadas.has(e.id)) return;
    if (!cantadas.some((c) => c.id === e.id)) {
      avisar(`«${e.nombre_mazahua}» todavía no ha salido.`, "aviso");
      return;
    }
    marcadas.add(e.id);
    tableroEl.querySelector(`[data-id="${e.id}"]`)?.classList.add("marcada");
    avisar("¡Bien! Carta marcada.", "ok");
    if (hayLinea()) terminar("🎉 ¡Lotería! Completaste una línea.", true);
  }

  function cantar() {
    if (terminado) return;
    const siguiente = baraja.shift();
    if (!siguiente) {
      terminar("Se acabó la baraja. ¡Fin de la partida!");
      return;
    }
    actual = siguiente;
    cantadas.push(siguiente);
    pintarActual();
    pintarHistorial();
    btnRepetir.disabled = false;
    reproducir(siguiente);
    avisar("Busca la carta en tu tablero y púlsala.");
    if (baraja.length === 0) btnCantar.textContent = "Última carta cantada";
  }

  async function errorDe(r: Response): Promise<string> {
    try {
      const d = await r.json();
      if (typeof d.detail === "string") return d.detail;
    } catch {}
    return `Error ${r.status}`;
  }

  async function nuevaPartida() {
    if (!modoJuego) return;
    detener();
    btnNueva.disabled = true;
    btnCantar.disabled = true;
    btnRepetir.disabled = true;
    btnCantar.textContent = "Cantar carta";
    terminado = false;
    actual = null;
    cantadas = [];
    marcadas = new Set();
    pintarActual();
    pintarHistorial();
    avisar("Preparando partida…");

    try {
      const rt = await fetch(`${API}/api/juego/tablero?tamano=${lado * lado}`);
      if (!rt.ok) throw new Error(await errorDe(rt));
      tablero = await rt.json();

      if (modoSel.value === "todas") {
        const rb = await fetch(`${API}/api/juego/baraja`);
        if (!rb.ok) throw new Error(await errorDe(rb));
        baraja = await rb.json();
      } else {
        baraja = barajar(tablero);
      }

      pintarTablero();
      pintarHistorial();
      btnCantar.disabled = false;
      avisar("Partida lista. Pulsa «Cantar carta».");
    } catch (err) {
      tablero = [];
      tableroEl.replaceChildren();
      const msg = (err as Error).message;
      avisar(
        msg.includes("fetch")
          ? "No se pudo conectar con la API. ¿Está corriendo uvicorn?"
          : msg,
        "aviso"
      );
    } finally {
      btnNueva.disabled = false;
    }
  }

  function iniciarLibre() {
    modoJuego = "libre";
    sessionStorage.removeItem(CLAVE);
    lado = Math.round(Math.sqrt(Number(tamanoSel.value)));
    etiquetaEl.textContent = "Juego libre";
    lblTamano.hidden = false;
    mostrar("juego");
    nuevaPartida();
  }

  async function entrarConCodigo(codigo: string) {
    const limpio = codigo.trim().toUpperCase();
    if (!limpio) return;

    btnEntrar.disabled = true;
    avisarEntrada("Buscando partida…", "ok");

    try {
      const r = await fetch(`${API}/api/partidas/${encodeURIComponent(limpio)}`);
      if (r.status === 404) throw new Error("Ese código no existe. Revisa que esté bien escrito.");
      if (!r.ok) throw new Error(await errorDe(r));

      const partida = (await r.json()) as Partida;
      modoJuego = "codigo";
      lado = Math.round(Math.sqrt(partida.cartas_por_tablero));
      sessionStorage.setItem(CLAVE, partida.codigo);

      etiquetaEl.textContent = `Partida ${partida.codigo}`;
      lblTamano.hidden = true;
      avisarEntrada("");
      mostrar("juego");
      await nuevaPartida();
    } catch (err) {
      sessionStorage.removeItem(CLAVE);
      mostrar("entrada");
      const msg = (err as Error).message;
      avisarEntrada(
        msg.includes("fetch")
          ? "No se pudo conectar con la API. Si el servidor estaba dormido, espera un minuto e intenta otra vez."
          : msg,
        "aviso"
      );
    } finally {
      btnEntrar.disabled = false;
    }
  }

  function irAModos() {
    detener();
    modoJuego = null;
    tablero = [];
    baraja = [];
    cantadas = [];
    actual = null;
    marcadas = new Set();
    sessionStorage.removeItem(CLAVE);
    inputCodigo.value = "";
    avisarEntrada("");
    cargarCartasPreview();
    mostrar("modos");
  }

  $("modo-codigo").addEventListener("click", () => {
    mostrar("entrada");
    inputCodigo.focus();
  });
  $("modo-libre").addEventListener("click", iniciarLibre);
  $("btn-volver").addEventListener("click", irAModos);
  $("btn-cambiar").addEventListener("click", irAModos);

  $("form-codigo").addEventListener("submit", (e) => {
    e.preventDefault();
    entrarConCodigo(inputCodigo.value);
  });

  tamanoSel.addEventListener("change", () => {
    lado = Math.round(Math.sqrt(Number(tamanoSel.value)));
    nuevaPartida();
  });
  btnNueva.addEventListener("click", nuevaPartida);
  btnCantar.addEventListener("click", cantar);
  btnRepetir.addEventListener("click", () => actual && reproducir(actual));
  modoSel.addEventListener("change", nuevaPartida);

  const inicial = new URLSearchParams(location.search).get("codigo") || sessionStorage.getItem(CLAVE);
  if (inicial) {
    inputCodigo.value = inicial.toUpperCase();
    entrarConCodigo(inicial);
  } else {
    cargarCartasPreview();
    mostrar("modos");
  }
</script>

<style is:global>
  [hidden] { display: none !important; }

  main {
    max-width: 1380px;
    width: 100%;
    margin: 0 auto;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }

  .contenedor-modos {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(340px, 0.85fr) minmax(460px, 1.35fr);
    grid-template-rows: auto 1fr;
    gap: 1.25rem 2rem;
    align-items: stretch;
    margin: 0.75rem auto 1.5rem;
  }

  .titulo-pagina {
    grid-column: 1 / -1;
    text-align: center;
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    margin: 0 0 0.5rem;
    color: #000000;
  }

  .modos {
    grid-column: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    width: 100%;
    margin: 0;
  }

  .modo-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 225px;
    padding: 1.4rem 1.5rem;
    border: 5px solid #fff;
    border-radius: 28px;
    color: #000000;
    font: inherit;
    text-align: center;
    cursor: pointer;
    box-shadow: 0 14px 32px rgba(74, 15, 36, 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .modo-card.con-codigo { background: var(--vino); }
  .modo-card.libre { background: var(--vino-claro); }

  .modo-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(74, 15, 36, 0.4);
  }

  .modo-icono { font-size: 4rem; line-height: 1; color: #000000; }

  .modo-card strong {
    font-family: var(--titulos);
    font-size: clamp(1.6rem, 2.2vw, 2.3rem);
    line-height: 1.1;
    color: #000000;
  }

  .modo-card span:last-child {
    font-size: clamp(1rem, 1.35vw, 1.3rem);
    line-height: 1.4;
    max-width: 24rem;
    color: #000000;
  }

  .vitrina-cartas {
    grid-column: 2;
    width: 100%;
    height: 100%;
    min-height: 470px;
    padding: 2.25rem 2rem;
    border-radius: 28px;
    background: var(--vino);
    border: 5px solid #fff;
    box-shadow: 0 14px 32px rgba(74, 15, 36, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cartas-abanico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .carta-muestra {
    width: clamp(150px, 16.5vw, 225px);
    background: #eef1f5;
    border: 5px solid #f0be45;
    border-radius: 22px;
    padding: 0.65rem 0.65rem 0.85rem;
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.38);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .carta-muestra:nth-child(1) { transform: rotate(-7deg) translateY(8px); z-index: 1; }
  .carta-muestra:nth-child(2) { transform: rotate(0deg) translateY(-8px); margin: 0 -0.5rem; z-index: 2; }
  .carta-muestra:nth-child(3) { transform: rotate(7deg) translateY(10px); z-index: 1; }
  .carta-muestra:hover { transform: translateY(-16px) rotate(0deg) scale(1.05); z-index: 5; background: #f8fafc; }

  .carta-muestra-img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    background: #eef1f5;
    display: grid;
    place-items: center;
  }

  .carta-muestra-img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .carta-muestra-sin-img {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--titulos);
    font-size: 3.4rem;
    font-weight: 800;
    color: #000000;
    background: #eef1f5;
  }

  .carta-muestra-nombre {
    font-family: var(--titulos);
    font-size: clamp(1.2rem, 1.65vw, 1.7rem);
    font-weight: 800;
