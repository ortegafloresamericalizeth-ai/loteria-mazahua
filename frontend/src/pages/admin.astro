---
import Base from "../layouts/Base.astro";
---

<Base titulo="Docentes">

  <h2 class="titulo-admin">Zona de docentes</h2>

  <!-- Acceso de docentes -->
  <div id="acceso" class="acceso-layout">

    <!-- Formulario -->
    <section class="tarjeta-admin formulario-docente">
      <h3 id="titulo-recuadro" class="titulo-recuadro">Regístrate aquí</h3>

      <!-- Formulario para iniciar sesión -->
      <form id="form-login">

        <label>
          Correo
          <input
            id="l-correo"
            type="email"
            autocomplete="email"
            required
          />
        </label>

        <label>
          Contraseña
          <input
            id="l-pass"
            type="password"
            autocomplete="current-password"
            required
          />
        </label>

        <div class="botones-docente">
          <button class="btn btn-entrar" type="submit">
            Entrar
          </button>

          <button
            class="btn btn-registro"
            type="button"
            id="ir-registro"
          >
            Crear cuenta
          </button>
        </div>

      </form>

      <!-- Formulario para crear cuenta -->
      <form id="form-registro" hidden>

        <label>
          Nombre
          <input
            id="r-nombre"
            type="text"
            autocomplete="name"
            minlength="2"
            required
          />
        </label>

        <label>
          Correo
          <input
            id="r-correo"
            type="email"
            autocomplete="email"
            required
          />
        </label>

        <label>
          Contraseña (mínimo 8 caracteres)
          <input
            id="r-pass"
            type="password"
            autocomplete="new-password"
            minlength="8"
            required
          />
        </label>

        <label>
          Código de docente
          <small>(Solo si tu institución te lo dio)</small>
          <input
            id="r-codigo"
            type="text"
            autocomplete="off"
          />
        </label>

        <div class="botones-docente">
          <button class="btn btn-entrar" type="submit">
            Crear cuenta
          </button>

          <button
            class="btn btn-registro"
            type="button"
            id="ir-login"
          >
            Entrar
          </button>
        </div>

      </form>

    </section>

    <!-- Imagen del docente -->
    <div class="imagen-docente">
      <img
        src="/imagenes/docente.jpg"
        alt="Docente de la Lotería Mazahua"
      />
    </div>

  </div>

  <!-- Panel del docente -->
  <section id="panel" hidden>

    <div class="tarjeta-admin">

      <div class="fila-titulo">
        <h3>
          Hola, <span id="nombre-docente"></span>
        </h3>

        <button
          class="btn secundario"
          id="btn-salir"
          type="button"
        >
          Cerrar sesión
        </button>
      </div>

      <h4>Crear partida</h4>

      <form id="form-partida">

        <label>
          Número de tableros
          <input
            id="tableros"
            type="number"
            min="1"
            max="40"
            value="4"
            required
          />
        </label>

        <label>
          Cartas por tablero
          <select id="cartas">
            <option value="9">9 cartas (3 × 3)</option>
            <option value="16" selected>16 cartas (4 × 4)</option>
          </select>
        </label>

        <button class="btn" type="submit">
          Crear partida
        </button>

      </form>

    </div>

    <div class="tarjeta-admin">

      <h3>Mis partidas</h3>

      <ul id="lista-partidas" class="lista-partidas"></ul>

      <p id="sin-partidas" class="vacio-admin">
        Todavía no has creado partidas.
      </p>

    </div>

  </section>

  <p id="aviso-admin" class="aviso-admin" role="status"></p>

</Base>

<script>
  import { API } from "../config";

  const CLAVE = "docente_token";

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  interface Partida {
    codigo: string;
    tableros: number;
    cartas_por_tablero: number;
    creado: string | null;
  }

  function avisar(texto: string, ok = false) {
    const el = $("aviso-admin");
    el.textContent = texto;
    el.className = "aviso-admin " + (ok ? "ok" : "error");
  }

  function mostrar(conSesion: boolean) {
    $("acceso").hidden = conSesion;
    $("panel").hidden = !conSesion;
  }

  function cerrarLocal() {
    localStorage.removeItem(CLAVE);
    mostrar(false);
  }

  // ---------- Conexión con API ----------
  async function api(
    ruta: string,
    opciones: RequestInit = {}
  ) {
    const token = localStorage.getItem(CLAVE);

    const r = await fetch(`${API}${ruta}`, {
      ...opciones,
      headers: {
        "Content-Type": "application/json",
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    });

    if (!r.ok) {
      let msg = `Error ${r.status}`;

      try {
        const d = await r.json();

        if (typeof d.detail === "string") {
          msg = d.detail;
        } else if (Array.isArray(d.detail)) {
          msg = "Revisa los datos: " + d.detail[0]?.msg;
        }
      } catch {}

      const e = new Error(msg) as Error & {
        status: number;
      };

      e.status = r.status;
      throw e;
    }

    return r.json();
  }

  // ---------- Iniciar sesión ----------
  function entrar(datos: { token: string; nombre: string }) {
    localStorage.setItem(CLAVE, datos.token);

    $("nombre-docente").textContent = datos.nombre;

    avisar("");
    mostrar(true);
    cargarPartidas();
  }

  // ---------- Cambiar entre formularios ----------
  function pestana(registro: boolean) {
    $("form-login").hidden = registro;
    $("form-registro").hidden = !registro;
    $("titulo-recuadro").textContent = registro
      ? "Crea tu cuenta aquí"
      : "Regístrate aquí";
    avisar("");
  }

  $("ir-registro").addEventListener("click", () => {
    pestana(true);
  });

  $("ir-login").addEventListener("click", () => {
    pestana(false);
  });

  // ---------- Entrar ----------
  $("form-login").addEventListener("submit", async (e) => {
    e.preventDefault();

    avisar("Verificando…", true);

    try {
      const d = await api("/api/admin/login", {
        method: "POST",
        body: JSON.stringify({
          correo: $<HTMLInputElement>("l-correo").value,
          password: $<HTMLInputElement>("l-pass").value,
        }),
      });

      $<HTMLInputElement>("l-pass").value = "";

      entrar(d);

    } catch (err) {
      avisar((err as Error).message);
    }
  });

  // ---------- Crear cuenta ----------
  $("form-registro").addEventListener("submit", async (e) => {
    e.preventDefault();

    avisar("Creando cuenta…", true);

    try {
      const d = await api("/api/admin/registro", {
        method: "POST",
        body: JSON.stringify({
          nombre: $<HTMLInputElement>("r-nombre").value,
          correo: $<HTMLInputElement>("r-correo").value,
          password: $<HTMLInputElement>("r-pass").value,
          codigo: $<HTMLInputElement>("r-codigo").value,
        }),
      });

      $<HTMLInputElement>("r-pass").value = "";

      entrar(d);

    } catch (err) {
      avisar((err as Error).message);
    }
  });

  // ---------- Cerrar sesión ----------
  $("btn-salir").addEventListener("click", async () => {
    try {
      await api("/api/admin/salir", {
        method: "POST",
      });
    } catch {}

    cerrarLocal();
    avisar("");
  });

  // ---------- Partidas ----------
  function pintarPartidas(lista: Partida[]) {
    $("sin-partidas").hidden = lista.length > 0;

    $("lista-partidas").replaceChildren(
      ...lista.map((p) => {

        const li = document.createElement("li");
        li.className = "partida";

        const cod = document.createElement("span");
        cod.className = "codigo-mini";
        cod.textContent = p.codigo;

        const info = document.createElement("span");
        info.className = "info-partida";
        info.textContent =
          `${p.tableros} tableros · ${p.cartas_por_tablero} cartas`;

        const copiar = document.createElement("button");
        copiar.type = "button";
        copiar.className = "btn secundario chico";
        copiar.textContent = "Copiar código";

        copiar.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(p.codigo);
            avisar(`Código ${p.codigo} copiado.`, true);
          } catch {
            avisar(`Tu código es ${p.codigo}`, true);
          }
        });

        const borrar = document.createElement("button");
        borrar.type = "button";
        borrar.className = "btn secundario chico peligro";
        borrar.textContent = "Eliminar";

        borrar.addEventListener("click", async () => {
          if (!confirm(`¿Eliminar la partida ${p.codigo}?`)) return;

          try {
            await api(`/api/admin/partidas/${p.codigo}`, {
              method: "DELETE",
            });

            avisar("Partida eliminada.", true);
            cargarPartidas();

          } catch (err) {
            avisar((err as Error).message);
          }
        });

        li.append(cod, info, copiar, borrar);
        return li;
      })
    );
  }

  async function cargarPartidas() {
    try {
      pintarPartidas(
        await api("/api/admin/partidas")
      );

    } catch (err) {
      if ((err as { status?: number }).status === 401) {
        cerrarLocal();
        avisar("Tu sesión expiró. Inicia sesión de nuevo.");
      } else {
        avisar((err as Error).message);
      }
    }
  }

  // ---------- Crear partida ----------
  $("form-partida").addEventListener("submit", async (e) => {
    e.preventDefault();

    avisar("Creando partida…", true);

    try {
      const p: Partida = await api("/api/admin/partidas", {
        method: "POST",
        body: JSON.stringify({
          tableros: Number(
            $<HTMLInputElement>("tableros").value
          ),
          cartas_por_tablero: Number(
            $<HTMLSelectElement>("cartas").value
          ),
        }),
      });

      avisar(`Partida creada. Código: ${p.codigo}`, true);
      cargarPartidas();

    } catch (err) {
      avisar((err as Error).message);
    }
  });

  // ---------- Al cargar la página ----------
  (async function iniciar() {

    if (!localStorage.getItem(CLAVE)) {
      return mostrar(false);
    }

    try {
      const d = await api("/api/admin/yo");

      $("nombre-docente").textContent = d.nombre;

      mostrar(true);
      cargarPartidas();

    } catch {
      cerrarLocal();
    }

  })();
</script>

<style is:global>

  /* ---------- Título ---------- */

  .titulo-admin {
    text-align: center;
    color: #111;
    font-size: clamp(2.2rem, 4.2vw, 3.3rem);
    margin: 0 0 2rem;
  }

  [hidden] {
    display: none !important;
  }

  /* ---------- Distribución principal ---------- */

  .acceso-layout {
    width: 96%;
    max-width: 1380px;
    margin: 25px auto 2rem;
    display: grid;
    grid-template-columns: minmax(380px, 1.2fr) minmax(360px, 1fr);
    align-items: start;
    gap: 42px;
  }

  /* ---------- Formulario ---------- */

  .formulario-docente {
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
    padding: 28px 40px 36px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background: #fff;
    border: 3px solid var(--vino);
    border-radius: 24px;
    box-shadow: 0 10px 0 var(--vino-osc);
  }

  .titulo-recuadro {
    margin: 0 0 1.1rem;
    text-align: center;
    color: #111;
    font-family: var(--titulos);
    font-size: clamp(1.65rem, 2.4vw, 2.2rem);
    line-height: 1.15;
  }

  .formulario-docente form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .formulario-docente label {
    display: grid;
    gap: 8px;
    color: #111;
    font-size: 20px;
    font-weight: 700;
  }

  .formulario-docente input {
    width: 100%;
    height: 60px;
    box-sizing: border-box;
    padding: 14px 18px;
    border: 2px solid #dfb6c5;
    border-radius: 12px;
    font: inherit;
    font-size: 18px;
    color: #111;
    background: white;
  }

  .formulario-docente input:focus {
    outline: 3px solid var(--oro);
    border-color: var(--vino);
  }

  .formulario-docente small {
    font-weight: 400;
    font-size: 15px;
    color: #7a6a58;
  }

  /* ---------- Botones inferiores ---------- */

  .botones-docente {
    display: flex;
    gap: 16px;
    width: 100%;
    margin-top: 6px;
  }

  .botones-docente button {
    flex: 1;
    min-width: 0;
    min-height: 60px;
    padding: 14px 16px;
    border-radius: 32px;
    font-size: 18px;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .botones-docente button:hover {
    transform: translateY(-3px);
  }

  .btn-entrar {
    background: var(--vino);
    color: white;
    border: 2px solid var(--vino);
  }

  .btn-registro {
    background: white;
    color: #111;
    border: 2px solid var(--vino);
  }

  /* ---------- Imagen del docente ---------- */

  .imagen-docente {
    width: 100%;
    height: auto;
    min-height: 420px;
    border-radius: 26px;
    overflow: hidden;
    border: 5px solid white;
    box-shadow: 0 12px 28px rgba(74, 15, 36, 0.25);
    background: #fdf8ee;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .imagen-docente img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  /* ---------- Panel de administración ---------- */

  #panel {
    width: 94%;
    max-width: 1100px;
    margin: 25px auto;
  }

  .tarjeta-admin {
    width: 100%;
    max-width: 520px;
    margin: 0 auto 1.2rem;
    background: #fff;
    border: 4px solid var(--vino);
    border-radius: 22px;
    padding: 1.2rem 1.4rem;
    box-shadow: 0 8px 0 var(--vino-osc);
    box-sizing: border-box;
  }

  .tarjeta-admin h3 {
    margin: 0 0 0.8rem;
    color: #111;
  }

  .tarjeta-admin h4 {
    margin: 0.4rem 0 0.6rem;
    color: #111;
  }

  .tarjeta-admin form {
    display: grid;
    gap: 0.9rem;
  }

  .tarjeta-admin label {
    display: grid;
    gap: 0.3rem;
    color: #111;
    font-weight: 600;
  }

  .tarjeta-admin input,
  .tarjeta-admin select {
    font: inherit;
    padding: 0.6rem 0.8rem;
    border: 2px solid #d9c3cc;
    border-radius: 12px;
    color: #111;
  }

  .tarjeta-admin input:focus,
  .tarjeta-admin select:focus {
    outline: 3px solid var(--oro);
    border-color: var(--vino);
  }

  .fila-titulo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  .fila-titulo h3 {
    margin: 0;
  }

  .btn.secundario {
    background: #fff;
    color: #111;
    border: 2px solid var(--vino);
    box-shadow: none;
    padding: 0.4rem 0.9rem;
    min-height: 0;
    font-size: 1rem;
  }

  .btn.chico {
    padding: 0.3rem 0.7rem;
    font-size: 0.9rem;
  }

  .btn.peligro {
    color: #a3262a;
    border-color: #a3262a;
  }

  .lista-partidas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .partida {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0.6rem 0.8rem;
    background: #fbf3e4;
    border-radius: 14px;
  }

  .codigo-mini {
    font-family: var(--titulos);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: 3px;
    color: #111;
  }

  .info-partida {
    flex: 1;
    font-size: 0.95rem;
    color: #111;
  }

  .vacio-admin {
    margin: 0;
    color: #7a6a58;
    text-align: center;
  }

  .aviso-admin {
    text-align: center;
    font-weight: 700;
    min-height: 1.5em;
  }

  .aviso-admin.ok {
    color: var(--verde);
  }

  .aviso-admin.error {
    color: #111;
  }

  /* ---------- Adaptación a celulares ---------- */

  @media (max-width: 900px) {

    .acceso-layout {
      grid-template-columns: 1fr;
      align-items: center;
      max-width: 720px;
      gap: 28px;
    }

    .imagen-docente {
      height: 400px;
      min-height: 360px;
    }

  }

  @media (max-width: 500px) {

    .formulario-docente {
      padding: 24px 18px;
      min-height: auto;
    }

    .formulario-docente label {
      font-size: 17px;
    }

    .formulario-docente input {
      height: 52px;
      font-size: 16px;
    }

    .botones-docente button {
      font-size: 15px;
      min-height: 52px;
    }

    .imagen-docente {
      height: 300px;
      min-height: 280px;
    }

  }

</style>
