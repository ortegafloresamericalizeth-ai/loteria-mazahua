---
import Base from "../layouts/Base.astro";
---

<Base titulo="Administrar">
  <h2>Administrar vocabulario</h2>

  <form id="form" class="form">
    <h3 id="titulo-form">Agregar elemento</h3>
    <input type="hidden" id="id" />

    <div class="campos">
      <label>Español *
        <input id="nombre_espanol" required maxlength="100" />
      </label>
      <label>Mazahua *
        <input id="nombre_mazahua" required maxlength="100" />
      </label>
      <label>Categoría
        <input id="categoria" list="lista-categorias" maxlength="50" />
        <datalist id="lista-categorias"></datalist>
      </label>
      <label>UID RFID
        <input id="uid_rfid" maxlength="20" placeholder="Ej. 04A3B21C" />
      </label>
    </div>

    <label>Descripción
      <textarea id="descripcion" rows="2"></textarea>
    </label>

    <div class="campos">
      <label>Imagen (.jpg, .png, .webp)
        <input type="file" id="imagen" accept=".jpg,.jpeg,.png,.webp" />
      </label>
      <label>Audio mazahua (.mp3, .wav, .ogg)
        <input type="file" id="audio_mazahua" accept=".mp3,.wav,.ogg" />
      </label>
      <label>Audio español (.mp3, .wav, .ogg)
        <input type="file" id="audio_espanol" accept=".mp3,.wav,.ogg" />
      </label>
    </div>
    <p class="ayuda" id="ayuda-archivos"></p>

    <div class="botones">
      <button type="submit" id="btn-guardar">Agregar</button>
      <button type="button" id="btn-cancelar" hidden>Cancelar edición</button>
    </div>
  </form>

  <p id="mensaje" role="status"></p>

  <div class="filtros">
    <input id="buscar" type="search" placeholder="Buscar en la tabla…" />
  </div>

  <div class="tabla-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Español</th>
          <th>Mazahua</th>
          <th>Categoría</th>
          <th>Imagen</th>
          <th>Audio MZ</th>
          <th>Audio ES</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>
</Base>

<script>
  import { API } from "../config";

  interface Elemento {
    id: number;
    nombre_espanol: string;
    nombre_mazahua: string;
    descripcion: string | null;
    categoria: string | null;
    imagen: string | null;
    audio_mazahua: string | null;
    audio_espanol: string | null;
    uid_rfid: string | null;
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const form = $<HTMLFormElement>("form");
  const tituloForm = $("titulo-form");
  const ayuda = $("ayuda-archivos");
  const mensaje = $("mensaje");
  const tbody = $("tbody");
  const btnGuardar = $<HTMLButtonElement>("btn-guardar");
  const btnCancelar = $<HTMLButtonElement>("btn-cancelar");
  const inBuscar = $<HTMLInputElement>("buscar");
  const campos = ["id", "nombre_espanol", "nombre_mazahua", "categoria", "uid_rfid", "descripcion"];
  const archivos = ["imagen", "audio_mazahua", "audio_espanol"];

  let todos: Elemento[] = [];

  const norm = (t: string) =>
    t.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

  function avisar(texto: string, ok = true) {
    mensaje.textContent = texto;
    mensaje.className = ok ? "ok" : "error";
  }

  async function errorDe(r: Response): Promise<string> {
    try {
      const d = await r.json();
      if (typeof d.detail === "string") return d.detail;
      if (Array.isArray(d.detail)) return d.detail.map((x: any) => x.msg).join(", ");
    } catch {}
    return `Error ${r.status}`;
  }

  function limpiarFormulario() {
    form.reset();
    ($<HTMLInputElement>("id")).value = "";
    tituloForm.textContent = "Agregar elemento";
    btnGuardar.textContent = "Agregar";
    btnCancelar.hidden = true;
    ayuda.textContent = "";
  }

  function editar(e: Elemento) {
    ($<HTMLInputElement>("id")).value = String(e.id);
    ($<HTMLInputElement>("nombre_espanol")).value = e.nombre_espanol;
    ($<HTMLInputElement>("nombre_mazahua")).value = e.nombre_mazahua;
    ($<HTMLInputElement>("categoria")).value = e.categoria ?? "";
    ($<HTMLInputElement>("uid_rfid")).value = e.uid_rfid ?? "";
    ($<HTMLTextAreaElement>("descripcion")).value = e.descripcion ?? "";
    for (const a of archivos) ($<HTMLInputElement>(a)).value = "";

    tituloForm.textContent = `Editando: ${e.nombre_espanol}`;
    btnGuardar.textContent = "Guardar cambios";
    btnCancelar.hidden = false;
    ayuda.textContent =
      "Los archivos son opcionales: solo se reemplazan los que selecciones.";
    form.scrollIntoView({ behavior: "smooth" });
  }

  async function eliminar(e: Elemento) {
    if (!confirm(`¿Eliminar "${e.nombre_espanol}" y sus archivos? No se puede deshacer.`)) return;
    try {
      const r = await fetch(`${API}/api/elementos/${e.id}`, { method: "DELETE" });
      if (!r.ok) throw new Error(await errorDe(r));
      avisar(`"${e.nombre_espanol}" eliminado.`);
      if ($<HTMLInputElement>("id").value === String(e.id)) limpiarFormulario();
      await cargar();
    } catch (err) {
      avisar((err as Error).message, false);
    }
  }

  const marca = (v: string | null) => (v ? "✔" : "—");

  function fila(e: Elemento): HTMLTableRowElement {
    const tr = document.createElement("tr");
    const valores = [
      String(e.id),
      e.nombre_espanol,
      e.nombre_mazahua,
      e.categoria ?? "",
      marca(e.imagen),
      marca(e.audio_mazahua),
      marca(e.audio_espanol),
    ];
    for (const v of valores) {
      const td = document.createElement("td");
      td.textContent = v;
      tr.appendChild(td);
    }

    const acciones = document.createElement("td");
    const bEditar = document.createElement("button");
    bEditar.type = "button";
    bEditar.textContent = "Editar";
    bEditar.addEventListener("click", () => editar(e));
    const bBorrar = document.createElement("button");
    bBorrar.type = "button";
    bBorrar.textContent = "Eliminar";
    bBorrar.className = "peligro";
    bBorrar.addEventListener("click", () => eliminar(e));
    acciones.append(bEditar, bBorrar);
    tr.appendChild(acciones);
    return tr;
  }

  function pintar() {
    const q = norm(inBuscar.value.trim());
    const lista = todos.filter(
      (e) =>
        !q ||
        norm(e.nombre_espanol).includes(q) ||
        norm(e.nombre_mazahua).includes(q) ||
        norm(e.categoria ?? "").includes(q)
    );
    tbody.replaceChildren(...lista.map(fila));
  }

  async function cargar() {
    try {
      const r = await fetch(`${API}/api/elementos`);
      if (!r.ok) throw new Error(await errorDe(r));
      todos = await r.json();

      const dl = $("lista-categorias");
      const cats = [...new Set(todos.map((e) => e.categoria).filter(Boolean))].sort();
      dl.replaceChildren(...(cats as string[]).map((c) => new Option(c, c)));
      pintar();
    } catch {
      avisar("No se pudo conectar con la API. ¿Está corriendo uvicorn?", false);
    }
  }

  form.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const id = $<HTMLInputElement>("id").value;

    // Solo se envían los campos con contenido (evita sobrescribir con vacíos)
    const fd = new FormData();
    for (const c of campos.filter((c) => c !== "id")) {
      const el = $<HTMLInputElement | HTMLTextAreaElement>(c);
      let v = el.value.trim();
      if (c === "uid_rfid") v = v.toUpperCase();
      if (v) fd.append(c, v);
    }
    for (const a of archivos) {
      const f = $<HTMLInputElement>(a).files?.[0];
      if (f) fd.append(a, f);
    }

    btnGuardar.disabled = true;
    try {
      const r = await fetch(`${API}/api/elementos${id ? `/${id}` : ""}`, {
        method: id ? "PUT" : "POST",
        body: fd,
      });
      if (!r.ok) throw new Error(await errorDe(r));
      const guardado: Elemento = await r.json();
      avisar(id ? `"${guardado.nombre_espanol}" actualizado.` : `"${guardado.nombre_espanol}" agregado.`);
      limpiarFormulario();
      await cargar();
    } catch (err) {
      avisar((err as Error).message, false);
    } finally {
      btnGuardar.disabled = false;
    }
  });

  btnCancelar.addEventListener("click", limpiarFormulario);
  inBuscar.addEventListener("input", pintar);
  cargar();
</script>

<style is:global>
  .form {
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }
  .form h3 { margin-top: 0; color: var(--acento); }
  .form label { display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.6rem; }
  .form input:not([type="file"]), .form textarea {
    display: block;
    width: 100%;
    margin-top: 0.25rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--borde);
    border-radius: 8px;
    font: inherit;
  }
  .form input[type="file"] { display: block; margin-top: 0.25rem; max-width: 100%; }
  .campos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0 1rem;
  }
  .ayuda { font-size: 0.85rem; color: #7a6a58; margin: 0 0 0.5rem; min-height: 1em; }
  .botones { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .botones button, td button {
    border: 1px solid var(--acento);
    background: var(--acento);
    color: #fff;
    border-radius: 8px;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    font: inherit;
  }
  .botones button:disabled { opacity: 0.5; cursor: wait; }
  #btn-cancelar { background: #fff; color: var(--acento); }

  #mensaje { min-height: 1.4em; font-weight: 600; }
  #mensaje.ok { color: #1f7a3a; }
  #mensaje.error { color: #b3261e; }

  .tabla-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: var(--tarjeta); }
  th, td { padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--borde); text-align: left; white-space: nowrap; }
  th { background: #f3e6d2; }
  td button { padding: 0.25rem 0.6rem; margin-right: 0.3rem; background: #fff; color: var(--acento); }
  td button.peligro { color: #b3261e; border-color: #b3261e; }
  .filtros { margin: 1rem 0 0.5rem; }
  .filtros input {
    width: 100%;
    max-width: 380px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--borde);
    border-radius: 8px;
    font-size: 1rem;
  }
</style>